{
  "expo": {
    "name": "lettered",
    "slug": "lettered",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "club.lettered.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "club.lettered.app",
      "adaptiveIcon": {
        "backgroundColor": "#8DB6E0",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0C0C0B"
        }
      ]
    ],
    "scheme": "lettered",
    "backgroundColor": "#0C0C0B",
    "experiments": {
      "typedRoutes": true
    }
  }
}